{
  "name": "memory_app",
  "version": "1.0.0",
  "description": "基于艾宾浩斯遗忘曲线的科学记忆应用，支持古诗词、单词、成语的高效记忆。",
  "main": "sw.js",
  "scripts": {
    "build": "echo Build complete - files in dist folder",
    "start": "python -m http.server 8080",
    "cap:init": "npx cap init MemoryHelper com.memory.app --web-dir=dist",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "apk": "npm run cap:sync && cd android && gradlew assembleDebug"
  },
  "keywords": [
    "memory",
    "ebbinghaus",
    "flashcards",
    "study"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0"
  }
}